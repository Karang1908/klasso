# ---------------------------------------------------------------- Supabase
# Dashboard → Project Settings → API keys
#
# If you install the Supabase connector from the Vercel Marketplace it injects
# NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY and
# SUPABASE_SECRET_KEY instead. The app reads either naming scheme, so you do
# not need to rename anything in Vercel — only set these for local dev.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-only. Bypasses row-level security — never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# ------------------------------------------------------------- Web Push
# Regenerate with:  npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ------------------------------------------------------------------ Cron
# Shared secret between Supabase pg_cron and /api/cron/dispatch.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=
