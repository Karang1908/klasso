# ---------------------------------------------------------------- Supabase
# Dashboard → Project Settings → Data API  /  API Keys
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. Bypasses row-level security — never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ------------------------------------------------------------- Web Push
# Regenerate with:  npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ------------------------------------------------------------------ Cron
# Shared secret between Supabase pg_cron and /api/cron/dispatch.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=
